# Copy to .env and fill in. Never commit .env.

# Required. Generate with: agentguard gen-key  (or: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Comma-separate several keys to rotate: the first encrypts, all decrypt.
AGENTGUARD_ENCRYPTION_KEYS=

# Used by docker-compose for the bundled Postgres.
POSTGRES_PASSWORD=

# The URL people use to reach the dashboard (used in Slack buttons, webhook payloads and invitation links).
AGENTGUARD_PUBLIC_URL=http://localhost:8080

# Allow anyone who can reach the server to create an organization. Keep false for self-hosted installs.
AGENTGUARD_ALLOW_SIGNUP=false
